# VNest V2. No secrets belong in this file or in the repository.
# Copy to .env.local to change a value. Every variable is read in src/config/env.ts.

# Public origin used for canonical URLs, the sitemap and structured data.
# Required when the deployment is production, where it must be a public https origin:
# the build and the server refuse to start without one. Development and previews may use localhost.
SITE_URL=http://localhost:3000

# development | preview | production. Which deployment this is. Empty counts as not set.
# Not set: Vercel's own VERCEL_ENV is used; anywhere else the deployment is unidentified,
# which is treated as development (never indexable) and reported in the log.
# If this and the platform disagree, the one that is not production wins.
DEPLOY_ENV=development

# Search-engine indexing. Only the exact value "true" asks for it, and it takes effect only when
# the deployment is confirmed as production, SITE_URL is a public https origin and nothing is mocked.
SITE_INDEXABLE=false

# Property content: "mock" (neutral sample records) or "files" (src/content/properties).
CONTENT_SOURCE=mock

# Booking provider: "mock" (simulated, development only) or "none" (not connected).
BOOKING_PROVIDER=mock

# Mock provider only. Availability: mixed | all-available | with-rates | partial-availability |
# partial-failure | stale-prices | no-answer | sold-out | error | timeout
# On /stays the same names can be chosen per request with ?mock=<name> (mock provider only).
MOCK_AVAILABILITY_SCENARIO=mixed

# Mock provider only. Hand-off: not-integrated | redirect | embedded | native | offer-expired | error
MOCK_HANDOFF_SCENARIO=not-integrated

# Artificial delay in milliseconds, to see loading states. 0 disables it.
MOCK_LATENCY_MS=0

# Consultation form delivery (docs/handoff/BACKEND-HANDOFF.md §11). Server-side only.
# disabled (default: the form says it is not active, nothing is sent) | mock (local development only) | resend
CONSULTATION_DELIVERY=disabled
# Optional. Default hello@vnest.com.vn (confirmed by the owner 10/11/2026). A bare address, e.g. a staging test inbox.
# CONSULTATION_RECIPIENT=
# Required for "resend": a sender on a domain verified in Resend, e.g. "VNest Website <name@verified-domain>".
# CONSULTATION_SENDER=
# Required for "resend". A secret: set it in the host's secret store, never in this file or in Git.
# RESEND_API_KEY=
